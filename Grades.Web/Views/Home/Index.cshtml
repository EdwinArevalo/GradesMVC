@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-4">
    <h1 class="display-5">Registro de notas</h1>
    <p class="text-muted">Mantenimiento de estudiantes y de sus notas por curso.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-4 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Estudiantes</h5>
                <p class="card-text">Registrar, editar y eliminar estudiantes.</p>
                <a asp-controller="Students" asp-action="Index" class="btn btn-primary">Ver estudiantes</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Notas</h5>
                <p class="card-text">Registrar las tres notas de cada curso.</p>
                <a asp-controller="Grades" asp-action="Index" class="btn btn-primary">Ver notas</a>
            </div>
        </div>
    </div>
</div>
