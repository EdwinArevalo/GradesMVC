@model Grade

@{
    ViewData["Title"] = "Editar nota";

    // La lista de estudiantes la envió el controller en ViewData
    var students = (SelectList)ViewData["Students"]!;
}

<h1>Editar nota</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* El id viaja oculto para saber qué registro actualizar *@
            <input type="hidden" asp-for="GradeId" />

            <div class="mb-3">
                <label asp-for="StudentId" class="form-label"></label>
                <select asp-for="StudentId" asp-items="students" class="form-select"></select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Course" class="form-label"></label>
                <input asp-for="Course" class="form-control" />
                <span asp-validation-for="Course" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col mb-3">
                    <label asp-for="Score1" class="form-label"></label>
                    <input asp-for="Score1" class="form-control" />
                    <span asp-validation-for="Score1" class="text-danger"></span>
                </div>
                <div class="col mb-3">
                    <label asp-for="Score2" class="form-label"></label>
                    <input asp-for="Score2" class="form-control" />
                    <span asp-validation-for="Score2" class="text-danger"></span>
                </div>
                <div class="col mb-3">
                    <label asp-for="Score3" class="form-label"></label>
                    <input asp-for="Score3" class="form-control" />
                    <span asp-validation-for="Score3" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
