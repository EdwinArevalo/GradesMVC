@model IEnumerable<Grade>

@{
    ViewData["Title"] = "Notas";
}

<h1>Notas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva nota</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Curso</th>
            <th>Nota 1</th>
            <th>Nota 2</th>
            <th>Nota 3</th>
            <th>Promedio</th>
            <th>Condición</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var grade in Model)
        {
            @* Cada fila se dibuja con una vista parcial *@
            <partial name="_GradeRow" model="grade" />
        }
    </tbody>
</table>
