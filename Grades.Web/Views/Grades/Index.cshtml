@model IEnumerable<Grade>

@{
    ViewData["Title"] = "Notas";

    // La lista de estudiantes la envió el controller en ViewData
    var students = (SelectList)ViewData["Students"]!;
}

<h1>Notas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva nota</a>
</p>

@* Filtro: envía el estudiante elegido por GET a /Grades?studentId=... *@
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="studentId" asp-items="students" class="form-select">
            <option value="">Todos los estudiantes</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Curso</th>
            <th>Nota 1</th>
            <th>Nota 2</th>
            <th>Nota 3</th>
            <th>Promedio</th>
            <th>Condición</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var grade in Model)
        {
            @* Cada fila se dibuja con una vista parcial *@
            <partial name="_GradeRow" model="grade" />
        }
    </tbody>
</table>
